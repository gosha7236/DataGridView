@using Entities
@model IReadOnlyList<Item>

@{
    ViewData["Title"] = "Список товаров";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">Добавить товар</a>
        <a asp-action="Index" class="btn btn-primary">Обновить</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Название</th>
                <th>Размер</th>
                <th>Материал</th>
                <th>Кол-во</th>
                <th>Мин.</th>
                <th>Цена</th>
                <th>Сумма</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Size</td>
                    <td>@item.Material</td>
                    <td>@item.Amount</td>
                    <td>@item.MinCount</td>
                    <td>@item.Price</td>
                    <td>@item.Total</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">✏</a>

                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Удалить товар?');">🗑</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>